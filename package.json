{
  "name": "developer-portfolio-generator",
  "version": "1.0.0",
  "description": "Full-Stack MERN Developer Portfolio Generator",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "mern",
    "portfolio-generator",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "Chamo",
  "license": "MIT"
}
